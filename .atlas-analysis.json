  "keyFeatures": [
    "Fluent chainable API via QrCode facade",
    "Blade component <x-qr-code> for templates",
    "Artisan CLI command qr:generate",
    "Multiple output formats: SVG, PNG, WebP, EPS",
    "Rich built-in data types: WiFi, vCard, Email, SMS, Geo, BTC, Ethereum, WhatsApp, Telegram, CalendarEvent",
    "Customizable styles, eye shapes, gradients, and color models (RGB, CMYK, Grayscale)",
    "Image/logo merging for PNG, WebP, and SVG",
    "Extensible via Laravel Macros",
    "Auto-discovery service provider and facade registration",
    "GD fallback when Imagick is unavailable"
  ],
  "publicApiSurface": [
    "QrCode::generate(string $text, ?string $filename = null)",
    "QrCode::size(int $size)",
    "QrCode::format(string $format)",
    "QrCode::color(int $c1, int $c2, int $c3, ?int $c4 = null)",
    "QrCode::backgroundColor(int $c1, int $c2, int $c3, ?int $c4 = null)",
    "QrCode::cmyk()",
    "QrCode::rgb()",
    "QrCode::gray(int $gray, ?int $backgroundGray = null)",
    "QrCode::style(string $style)",
    "QrCode::eye(string $style)",
    "QrCode::internalEye(string $style)",
    "QrCode::gradient(int $startR, int $startG, int $startB, int $endR, int $endG, int $endB, string $type)",
    "QrCode::margin(int $margin)",
    "QrCode::errorCorrection(string $level)",
    "QrCode::encoding(string $encoding)",
    "QrCode::merge(string $image, float $percentage, bool $absolute)",
    "QrCode::Email(string $to, string $subject, string $body)",
    "QrCode::PhoneNumber(string $phone)",
    "QrCode::SMS(string $phone, string $message)",
    "QrCode::Geo(float $lat, float $lng)",
    "QrCode::WiFi(array $config)",
    "QrCode::BTC(array $config)",
    "QrCode::Ethereum(string $address, float|null $amount)",
    "QrCode::VCard(array $config)",
    "QrCode::CalendarEvent(array $config)",
    "QrCode::WhatsApp(array $params)",
    "QrCode::Telegram(string $username)",
    "QrCode::macro(string $name, Closure $macro)",
    "<x-qr-code data='' size='' format='' color='' margin='' style='' errorCorrection='' />",
    "php artisan qr:generate [data] [--output] [--format] [--size] [--color] [--backgroundColor] [--errorCorrection] [--margin]"
  ]
